# Only needed when the frontend and API are deployed as separate services.
# Leave unset for local development (Vite proxies /api) and for any deployment
# that puts a reverse proxy in front of both.
#
# Vite inlines this at build time, so it must be set as a *build* environment
# variable on the host, not a runtime one.
VITE_API_BASE_URL=https://vehicle-search-api.onrender.com

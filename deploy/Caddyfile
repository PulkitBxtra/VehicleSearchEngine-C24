# Replace with your domain. Caddy provisions and renews the TLS certificate
# automatically, so there is no certbot cron to forget about.
{$SITE_ADDRESS:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy app:8080
	}

	handle /actuator/health {
		reverse_proxy app:8080
	}

	# SPA: every unmatched path serves index.html so client routing works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
